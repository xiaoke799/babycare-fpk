# 构建输出
*.fpk
app.tgz
.build_temp/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/

# 数据库
*.db
*.sqlite
*.sqlite3

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# IDE / Qoder / OMO 缓存
.codegraph/
.omo/
.qoder/

# 临时文件
temp_wizard_test/
test_data/
*.bak
*.log
# 一次性脚本与临时产物（下划线前缀）：避免 `git add -A` 误提交
_*.py
_*.txt
_*.json

# 但 Python 包的 __init__.py 必须留：少了它 Home Assistant 集成根本加载不了，
# 而且打包时若沿用 .gitignore，缺文件的包会一起发出去（2026-09-29 实测）
!__init__.py

# 密钥和本地配置
secret_key
.env
.env.local

# 会话临时产物：离线预览服务、DOM 探针、截图输出（用完即弃，不进仓库）
.workbuddy/tmp/

# 打包卫生暂存：app_hygiene.py --stage-out 移出的 __pycache__/data/verify 脚本
# （含真实数据库与密钥，绝不入库）
.workbuddy/pack_stash/

# 浏览器自动化 CLI 的运行时缓存（每次跑都会重建，不进仓库）
.playwright-cli/
